#include "resource.h"
#include "winres.h"
#include "vpnuihelper_version.h"

// Main icon for VPN UI Helper
IDI_HELPER ICON "VPN.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     VUI_FILEVER
 PRODUCTVERSION  VUI_FILEVER
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          0x40004L
 FILETYPE        0x1L
 FILESUBTYPE     0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    // 0409 = en-US, 04B0 = Unicode
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName",      "Unknown\0"
      VALUE "FileDescription",  "SoftEther VPN Tray App\0"
      VALUE "FileVersion",      VUI_FILEVER_STR "\0"
      VALUE "InternalName",     "vpnuihelper\0"
      VALUE "OriginalFilename", "vpnuihelper.exe\0"
      VALUE "ProductName",      "SoftEther VPN\0"
      VALUE "ProductVersion",   VUI_FILEVER_STR "\0"
      VALUE "LegalCopyright",  	"Copyright (c)\0"
    END
  END

  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END